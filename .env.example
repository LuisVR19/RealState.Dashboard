# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase.
# Solo la clave publicable (anon): la RLS protege los datos. NUNCA pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# URL pública del panel (enlaces de invitación y de recuperar contraseña). Debe estar en
# Supabase > Authentication > URL Configuration > Redirect URLs.
NEXT_PUBLIC_PANEL_URL=http://localhost:3001
# URL del sitio público (para "Ver sitio público", compartir y avisarle de cambios)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: URL interna del sitio si el panel lo alcanza por otra red (p. ej. en el mismo clúster)
# SITE_INTERNAL_URL=http://web:3000
# Mismo valor que REVALIDATE_SECRET del sitio público (POST /api/revalidate). Solo servidor.
REVALIDATE_SECRET=
